# API Keys
OPENAI_API_KEY=
OPENAI_ORG_ID=
COFOUNDER_API_KEY=your_cofounder_api_key_here

# Node Environment
NODE_ENV=development

# Service Ports
PORT=4200                 # Dashboard port
API_PORT=3000            # API server port
VITE_PORT=5173          # Vite dev server port
DB_PORT=5432            # PostgreSQL port
REDIS_PORT=6379         # Redis port
ADMINER_PORT=8080       # Adminer port
OLLAMA_PORT=11434
OPENAI_PROXY_PORT=3001

# Service URLs
API_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:4200
VITE_URL=http://localhost:5173

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cofounder_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=          # Optional, remove if not needed

# AI Services
# OpenAI (Optional - if not set, will use Ollama exclusively)
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Ollama Configuration
OLLAMA_API_URL=http://ollama:11434/v1
OLLAMA_MODELS=qwen2.5:0.5b,all-minilm
OLLAMA_ARCH=amd64  # Use arm64 for Apple Silicon
OLLAMA_ORIGINS=http://localhost:4200

# Security
JWT_SECRET=your_development_jwt_secret_here
CORS_ORIGIN=http://localhost:4200

# Feature Flags
DEBUG_MODE=true
ENABLE_SWAGGER=true

# Logging
LOG_LEVEL=debug         # debug, info, warn, error

# Volume Paths (relative to docker-compose.yml)
POSTGRES_DATA_PATH=./data/postgres
REDIS_DATA_PATH=./data/redis

# Resource Limits (optional)
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m
POSTGRES_MAX_CONNECTIONS=100
REDIS_MAXMEMORY=2gb

# Hot Reload Settings
CHOKIDAR_USEPOLLING=true    # Enable hot reload on Linux
WATCHPACK_POLLING=true      # Enable hot reload for Vite

# Development Features
VITE_DEV_SERVER_HTTPS=false  # Enable HTTPS for Vite
API_RATE_LIMIT=0             # Disable rate limiting in development
