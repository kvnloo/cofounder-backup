FROM node:22-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache python3 make g++ git

# Copy package files
COPY cofounder/boilerplate/package*.json ./

# Install dependencies
RUN npm install

# Copy boilerplate source code
COPY cofounder/boilerplate .

# Start in development mode
CMD ["npm", "run", "start"]
